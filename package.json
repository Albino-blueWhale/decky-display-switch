{
  "name": "decky-display-switch",
  "version": "0.1.0",
  "description": "Decky plugin: switch Game Mode between a laptop's built-in screen and an external display",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Albino-blueWhale/decky-display-switch.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "gamescope",
    "display",
    "laptop"
  ],
  "author": "Albino-blueWhale",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Albino-blueWhale/decky-display-switch/issues"
  },
  "homepage": "https://github.com/Albino-blueWhale/decky-display-switch#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
